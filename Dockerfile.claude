FROM node:20-alpine

# Install essential tools + Claude CLI
RUN apk add --no-cache git curl jq bash tmux openssh-client && \
    npm install -g @anthropic-ai/claude-code

# Create directories
RUN mkdir -p /root/.claude /root/.vibecraft/data /root/.vibecraft/hooks

# Copy hooks
COPY hooks/vibecraft-hook.sh /root/.vibecraft/hooks/
COPY hooks/bin/ /root/.vibecraft/hooks/bin/

# Environment
ENV VIBECRAFT_DATA_DIR=/root/.vibecraft/data
ENV VIBECRAFT_WS_NOTIFY=http://vibecraft-hub:4003/event

# Start tmux server on container start
CMD ["sh", "-c", "tmux start-server && tail -f /dev/null"]
